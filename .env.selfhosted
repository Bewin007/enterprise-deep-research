# Enterprise Deep Research - Self-Hosted Configuration
# Copy this file to .env to use self-hosted models

# ========================================
# REQUIRED API KEYS (Still needed for web search and code execution)
# ========================================

# Tavily API key for web search (required)
# Get your key from: https://app.tavily.com/
TAVILY_API_KEY=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

# E2B API key for code execution (optional but recommended)
# Get your key from: https://e2b.dev/docs/getting-started/api-key
E2B_API_KEY=your_e2b_api_key_here

# ========================================
# SELF-HOSTED LLM CONFIGURATION
# ========================================

# Option 1: Ollama (Recommended for beginners)
# ----------------------------------------
LLM_PROVIDER=ollama
LLM_MODEL=llama3.3:latest
OLLAMA_BASE_URL=http://ollama:11434

# Available Ollama models:
# - llama3.3:latest (recommended, 16GB RAM)
# - llama3.2:latest
# - llama3.1:8b
# - mistral:latest (7B parameters)
# - codellama:latest (for code generation)
# - phi3:latest (lightweight, 8GB RAM)
# - gemma2:latest
# - qwen2.5:latest

# Option 2: LocalAI (Multi-backend support)
# ----------------------------------------
# LLM_PROVIDER=localai
# LLM_MODEL=llama-3-8b
# LOCALAI_BASE_URL=http://localai:8080
# LOCALAI_API_KEY=optional_api_key

# Option 3: vLLM (High performance, requires GPU)
# ----------------------------------------
# LLM_PROVIDER=vllm
# LLM_MODEL=meta-llama/Llama-3.1-8B-Instruct
# VLLM_BASE_URL=http://vllm:8000
# VLLM_API_KEY=optional_api_key

# Option 4: Generic OpenAI-Compatible Endpoint
# ----------------------------------------
# Use this for llama.cpp, text-generation-webui, FastChat, etc.
# LLM_PROVIDER=openai-compatible
# LLM_MODEL=your-model-name
# OPENAI_COMPATIBLE_BASE_URL=http://your-server:8000
# OPENAI_COMPATIBLE_API_KEY=optional_api_key

# ========================================
# ACTIVITY GENERATION CONFIGURATION
# ========================================

# Use same self-hosted model for activity generation
ENABLE_ACTIVITY_GENERATION=true
ACTIVITY_VERBOSITY=medium
ACTIVITY_LLM_PROVIDER=ollama
ACTIVITY_LLM_MODEL=llama3.3:latest

# Or use a smaller/faster model for activities
# ACTIVITY_LLM_MODEL=phi3:latest

# ========================================
# APPLICATION SETTINGS
# ========================================

# Maximum number of web research iterations
MAX_WEB_RESEARCH_LOOPS=10

# Fetch full page content when researching
FETCH_FULL_PAGE=true

# ========================================
# OPTIONAL: FALLBACK TO CLOUD PROVIDERS
# ========================================

# You can still configure cloud providers as fallback options
# Uncomment and add your API keys if you want hybrid setup

# OpenAI (optional fallback)
# OPENAI_API_KEY=your_openai_api_key

# Anthropic Claude (optional fallback)
# ANTHROPIC_API_KEY=your_anthropic_api_key

# Google Vertex AI (optional fallback)
# GOOGLE_CLOUD_PROJECT=your_gcp_project
# GOOGLE_CLOUD_LOCATION=us-central1

# Groq (optional fallback)
# GROQ_API_KEY=your_groq_api_key

# ========================================
# MONITORING AND TRACING (Optional)
# ========================================

# LangChain/LangSmith tracing
LANGCHAIN_TRACING_V2=false
# LANGCHAIN_API_KEY=your_langchain_api_key
# LANGCHAIN_PROJECT=your_project_name
# LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# ========================================
# ADVANCED SETTINGS
# ========================================

# Model temperature (0.0 - 1.0, lower is more deterministic)
# LLM_TEMPERATURE=0.7

# Maximum tokens to generate
# LLM_MAX_TOKENS=4096

# Number of parallel Ollama requests
# OLLAMA_NUM_PARALLEL=2

# GPU memory allocation for Ollama (in MB)
# OLLAMA_GPU_MEMORY=8192

# Context window size
# OLLAMA_NUM_CTX=4096

# ========================================
# DOCKER-SPECIFIC SETTINGS
# ========================================

# These are used when running with docker-compose
# No need to change unless you have conflicts

# Ollama internal port (container-to-container)
# OLLAMA_INTERNAL_PORT=11434

# LocalAI internal port
# LOCALAI_INTERNAL_PORT=8080

# vLLM internal port
# VLLM_INTERNAL_PORT=8000